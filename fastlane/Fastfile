default_platform(:ios)

SCHEME       = "TodoApp"
PROJECT      = "TodoApp.xcodeproj"

# Resolve the best available iPhone 16 simulator at runtime
# so the same Fastfile works locally (iOS 18.0) and on CI (iOS 18.5/18.6)
def resolve_destination
  # Ask simctl for all available iPhone 16 runtimes, pick the highest stable iOS version
  raw = `xcrun simctl list devices available --json 2>/dev/null`
  require 'json'
  devices = JSON.parse(raw)["devices"]
  candidates = []
  devices.each do |runtime, sims|
    # Match stable iOS runtimes only (e.g. com.apple.CoreSimulator.SimRuntime.iOS-18-0)
    next unless runtime =~ /SimRuntime\.iOS-(\d+)-(\d+)/
    major = $1.to_i
    minor = $2.to_i
    next if major >= 26  # skip beta/visionOS-era runtimes
    sims.each do |sim|
      candidates << { major: major, minor: minor, udid: sim["udid"], name: sim["name"] } if sim["name"] == "iPhone 16"
    end
  end
  raise "No iPhone 16 simulator found!" if candidates.empty?
  best = candidates.max_by { |c| [c[:major], c[:minor]] }
  "platform=iOS Simulator,id=#{best[:udid]}"
end

DESTINATION = resolve_destination

platform :ios do

  # ── Shared setup ──────────────────────────────────────────────────────────

  desc "Generate Xcode project from project.yml"
  lane :generate do
    project_root = File.expand_path("..", __dir__)
    sh("xcodegen generate --spec #{project_root}/project.yml --project #{project_root}")
  end

  desc "Run SwiftLint"
  lane :lint do
    swiftlint(
      mode: :lint,
      strict: true,
      raise_if_swiftlint_error: true
    )
  end

  # ── CI lane (every branch) ────────────────────────────────────────────────

  desc "Lint + Build + Unit Tests — runs on every push"
  lane :ci do
    generate
    lint
    build
    unit_tests
  end

  # ── Full lane (main branch only) ──────────────────────────────────────────

  desc "Lint + Build + Unit Tests + UI Tests — runs on main"
  lane :full do
    generate
    lint
    build
    unit_tests
    ui_tests
  end

  # ── Individual lanes ──────────────────────────────────────────────────────

  desc "Build the app"
  lane :build do
    xcodebuild(
      project: PROJECT,
      scheme: SCHEME,
      destination: DESTINATION,
      configuration: "Debug",
      xcargs: "CODE_SIGNING_ALLOWED=NO",
      build: true
    )
  end

  desc "Run unit tests"
  lane :unit_tests do
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      destination: DESTINATION,
      only_testing: ["TodoAppTests"],
      configuration: "Debug",
      xcargs: "CODE_SIGNING_ALLOWED=NO",
      output_types: "junit",
      output_files: "unit-test-results.xml",
      fail_build: true
    )
  end

  desc "Run UI tests"
  lane :ui_tests do
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      destination: DESTINATION,
      only_testing: ["TodoAppUITests"],
      configuration: "Debug",
      xcargs: "CODE_SIGNING_ALLOWED=NO",
      output_types: "junit",
      output_files: "ui-test-results.xml",
      fail_build: true
    )
  end

end
